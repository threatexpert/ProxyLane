+
+/* Fork extension: independent, nonblocking channel-open operations.
+ * begin copies its arguments without doing I/O. poll returns EAGAIN while
+ * pending; every other return consumes the operation. On success it transfers
+ * the channel to *channel. cancel marks an operation for cancellation: keep
+ * polling it to close a late confirmation, or free the entire session.
+ * Serialize ALL calls on a session; this API does not add thread safety.
+ * Use a nonblocking session. There is no implicit open timeout.
+ */
+typedef struct _LIBSSH2_CHANNEL_OPEN LIBSSH2_CHANNEL_OPEN;
+LIBSSH2_API LIBSSH2_CHANNEL_OPEN *
+libssh2_channel_direct_tcpip_begin(LIBSSH2_SESSION *session, const char *host,
+                                  int port, const char *shost, int sport);
+LIBSSH2_API int libssh2_channel_open_poll(LIBSSH2_CHANNEL_OPEN *operation,
+                                        LIBSSH2_CHANNEL **channel);
+LIBSSH2_API void libssh2_channel_open_cancel(LIBSSH2_CHANNEL_OPEN *operation);
+
 #define libssh2_channel_direct_tcpip(session, host, port) \
     libssh2_channel_direct_tcpip_ex((session), (host), (port), "127.0.0.1", 22)
 
