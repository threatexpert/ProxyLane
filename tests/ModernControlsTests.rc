#include <windows.h>
6000 DIALOGEX 0, 0, 240, 120
STYLE DS_SETFONT | WS_POPUP
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT 4001, 8, 8, 200, 18, ES_AUTOHSCROLL
    CONTROL "Resource switch", 4002, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 34, 150, 18
    EDITTEXT 4003, 8, 60, 200, 40, ES_MULTILINE | ES_READONLY | WS_VSCROLL
END
